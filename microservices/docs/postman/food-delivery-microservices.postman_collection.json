{
  "info": {
    "_postman_id": "f2e7f677-5b68-4f7c-8fb3-9ab56aa5cb0d",
    "name": "Food Delivery Platform - Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const rawUrl = pm.request.url.toString();",
          "const token = pm.variables.get('token');",
          "if (!rawUrl.includes('/api/auth/') && token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "auth_username", "value": "postman_customer" },
    { "key": "auth_email", "value": "postman_customer@example.com" },
    { "key": "auth_password", "value": "Password123!" },
    { "key": "auth_phone", "value": "+233000000000" },
    { "key": "customer_id", "value": "1" },
    { "key": "restaurant_id", "value": "1" },
    { "key": "menu_item_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "delivery_id", "value": "1" },
    { "key": "city", "value": "Accra" },
    { "key": "cuisine", "value": "International" },
    { "key": "order_status", "value": "CONFIRMED" },
