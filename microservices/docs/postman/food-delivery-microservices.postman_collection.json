                  "if (token) {",
                  "  pm.sendRequest({",
                  "    url: `${pm.variables.get('base_url')}/api/restaurants/menu/${pm.variables.get('menu_item_id')}/toggle`,",
                  "    method: 'PATCH',",
                  "    header: { Authorization: `Bearer ${token}` }",
                  "  }, function (err, res) {",
                  "    pm.test('Re-toggle item to keep availability', function () {",
                  "      pm.expect(err).to.eql(null);",
                  "      pm.expect(res).to.have.property('code', 204);",
