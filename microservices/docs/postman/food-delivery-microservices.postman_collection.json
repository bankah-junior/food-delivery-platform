  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "const username = `postman_customer_${suffix}`;",
                  "const email = `${username}@example.com`;",
                  "const phone = `+233${String(suffix).slice(-9)}`;",
                  "const password = 'Password123!';",
                  "pm.collectionVariables.set('auth_username', username);",
                  "pm.collectionVariables.set('auth_email', email);",
                  "pm.collectionVariables.set('auth_password', password);",
                  "pm.collectionVariables.set('auth_phone', phone);",
                  "pm.environment.set('auth_username', username);",
                  "pm.environment.set('auth_email', email);",
                  "pm.environment.set('auth_password', password);",
                  "pm.environment.set('auth_phone', phone);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var responseData = pm.response.json();",
                  "pm.test('Register response has token', function () {",
                  "  pm.expect(responseData.token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (responseData.customerId) {",
                  "  pm.environment.set('customer_id', String(responseData.customerId));",
                  "  pm.collectionVariables.set('customer_id', String(responseData.customerId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"email\": \"{{auth_email}}\",\n  \"password\": \"{{auth_password}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Customer\",\n  \"phone\": \"{{auth_phone}}\",\n  \"deliveryAddress\": \"10 Test Street\",\n  \"city\": \"{{city}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "POST Login (save token to environment)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var responseData = pm.response.json();",
                  "pm.test('Login response has token', function () {",
                  "  pm.expect(responseData.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('token', responseData.token);",
                  "pm.collectionVariables.set('token', responseData.token);",
                  "if (responseData.customerId) {",
                  "  pm.environment.set('customer_id', String(responseData.customerId));",
                  "  pm.collectionVariables.set('customer_id', String(responseData.customerId));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
